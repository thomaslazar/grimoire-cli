# IDE
.idea/
.vs/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build outputs
bin/
obj/
out/
build/
dist/
publish/

# Packages
*.nupkg
packages/
node_modules/

# User-specific files
*.user
*.suo
*.log

# Environment
.env
.env.*

# Claude Code (machine-specific settings)
.claude/settings.local.json

# Release artifacts. The working release notes live at temp/release-notes.md,
# already covered by the temp entry below — a root release-notes.md is
# deliberately not ignored, so a copy the release forgot to delete shows up in
# git status rather than lingering unseen.
release-artifacts/

# Reference material — see CLAUDE.md for how to repopulate
temp
.superpowers/

# Local stack state. /data holds the Grimoire database plus the seeded
# users.json, which Grimoire renames to users.json.imported on first boot.
docker/data/
docker/.env
# The committed template is docker/env.example, with no leading dot: the .env.*
# rule above matches at any depth, and a dotted name also trips the managed
# Read(**/.env.*) permission rule, which blocks editing a file that holds only
# host paths.

# Fixture library generated by docker/seed.sh
docker/library/*
!docker/library/.gitkeep

# Add-on index generated by docker/make-addon-index.py; only the manifest(s)
# it describes are checked in
docker/addon-index/index.json

# Devcontainer feature lock — regenerated per machine on rebuild; abs-cli does not track it either
.devcontainer/devcontainer-lock.json
